{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "agent",
  "packet_sha256",
  "status"
 ],
 "properties": {
  "agent": {
   "const": "cross-pair-strategist"
  },
  "packet_sha256": {
   "type": "string"
  },
  "status": {
   "enum": [
    "OK",
    "ABORT"
   ]
  },
  "relative_strength": {
   "type": "object"
  },
  "big_move_attribution": {
   "type": "array"
  },
  "session_behaviour": {
   "type": "object"
  },
  "third_audit": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "candidate",
     "cross_pair"
    ],
    "properties": {
     "cross_pair": {
      "enum": [
       "confirms",
       "conflicts",
       "smt_favour",
       "none"
      ]
     },
     "confidence": {
      "type": "number"
     }
    }
   }
  },
  "new_candidates": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/cand"
   }
  },
  "pair_decision": {
   "type": "object",
   "properties": {
    "asia": {
     "enum": [
      "EURUSD",
      "GBPUSD",
      "either",
      "neither"
     ]
    },
    "london": {
     "enum": [
      "EURUSD",
      "GBPUSD",
      "either",
      "neither"
     ]
    },
    "newyork": {
     "enum": [
      "EURUSD",
      "GBPUSD",
      "either",
      "neither"
     ]
    }
   },
   "required": [
    "asia",
    "london",
    "newyork",
    "flip_if"
   ]
  },
  "rules": {
   "type": "array"
  }
 },
 "$defs": {
  "cand": {
   "type": "object",
   "required": [
    "id",
    "pair",
    "model",
    "direction",
    "entry",
    "invalidation",
    "target"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "pair": {
     "enum": [
      "EURUSD",
      "GBPUSD"
     ]
    },
    "model": {
     "type": "string"
    },
    "direction": {
     "enum": [
      "long",
      "short"
     ]
    },
    "thesis": {
     "type": "string"
    },
    "objects": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "families": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "entry": {
     "$ref": "#/$defs/lvl"
    },
    "invalidation": {
     "$ref": "#/$defs/lvl"
    },
    "target": {
     "$ref": "#/$defs/lvl"
    },
    "risk_pips": {
     "type": "number"
    },
    "reward_pips": {
     "type": "number"
    },
    "window_utc": {
     "type": "array"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "falsifier": {
     "type": "string"
    }
   }
  },
  "lvl": {
   "type": "object",
   "required": [
    "object",
    "price"
   ],
   "properties": {
    "object": {
     "type": "string"
    },
    "price": {
     "type": "number"
    }
   }
  }
 }
}
