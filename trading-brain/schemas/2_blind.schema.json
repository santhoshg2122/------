{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "candidates"
 ],
 "properties": {
  "candidates": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/cand"
   }
  }
 },
 "$defs": {
  "cand": {
   "type": "object",
   "required": [
    "id",
    "pair",
    "model",
    "direction",
    "entry",
    "invalidation",
    "target"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "pair": {
     "enum": [
      "EURUSD",
      "GBPUSD"
     ]
    },
    "model": {
     "type": "string"
    },
    "direction": {
     "enum": [
      "long",
      "short"
     ]
    },
    "thesis": {
     "type": "string"
    },
    "objects": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "families": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "entry": {
     "$ref": "#/$defs/lvl"
    },
    "invalidation": {
     "$ref": "#/$defs/lvl"
    },
    "target": {
     "$ref": "#/$defs/lvl"
    },
    "risk_pips": {
     "type": "number"
    },
    "reward_pips": {
     "type": "number"
    },
    "window_utc": {
     "type": "array"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "falsifier": {
     "type": "string"
    }
   }
  },
  "lvl": {
   "type": "object",
   "required": [
    "object",
    "price"
   ],
   "properties": {
    "object": {
     "type": "string"
    },
    "price": {
     "type": "number"
    }
   }
  }
 }
}
