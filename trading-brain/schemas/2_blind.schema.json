{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "candidates"
 ],
 "properties": {
  "candidates": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/cand"
   }
  },
  "candle_reading": {
   "type": "object",
   "required": [
    "EURUSD",
    "GBPUSD"
   ],
   "properties": {
    "EURUSD": {
     "type": "string",
     "minLength": 1
    },
    "GBPUSD": {
     "type": "string",
     "minLength": 1
    }
   }
  }
 },
 "$defs": {
  "cand": {
   "type": "object",
   "required": [
    "id",
    "pair",
    "model",
    "direction",
    "entry",
    "invalidation",
    "target"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "pair": {
     "enum": [
      "EURUSD",
      "GBPUSD"
     ]
    },
    "model": {
     "type": "string"
    },
    "direction": {
     "enum": [
      "long",
      "short"
     ]
    },
    "thesis": {
     "type": "string"
    },
    "objects": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^((EU|GB)-[A-Z]+-\\d+|X-(SMT|SDV)-\\d+|bar:(EURUSD|GBPUSD):M1:\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:(open|high|low|close))$"
     }
    },
    "families": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "entry": {
     "$ref": "#/$defs/lvl"
    },
    "invalidation": {
     "$ref": "#/$defs/lvl"
    },
    "target": {
     "$ref": "#/$defs/lvl"
    },
    "risk_pips": {
     "type": "number"
    },
    "reward_pips": {
     "type": "number"
    },
    "window_utc": {
     "type": "array"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "falsifier": {
     "type": "string"
    },
    "candle_basis": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{2,40}$",
     "description": "e.g. wick_rejection, engulfing, displacement_close, inside_bar, momentum_stall; becomes the signature's last segment"
    },
    "strategy_id": {
     "type": "string",
     "pattern": "^S\\d{3}$",
     "description": "the brain/strategies/ strategy this setup applies, when it applies one"
    }
   }
  },
  "lvl": {
   "type": "object",
   "required": [
    "object",
    "price"
   ],
   "properties": {
    "object": {
     "type": "string",
     "pattern": "^((EU|GB)-[A-Z]+-\\d+|X-(SMT|SDV)-\\d+|bar:(EURUSD|GBPUSD):M1:\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:(open|high|low|close))$",
     "description": "an object id, or a candle: bar:<PAIR>:M1:<YYYY-MM-DD HH:MM>:<open|high|low|close>"
    },
    "price": {
     "type": "number"
    }
   }
  }
 }
}
